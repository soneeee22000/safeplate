# SafePlate configuration. Copy this file to .env; .env is gitignored, never commit it.
# Values already set in the real environment take precedence over this file.

# `gemma` hears and speaks through the local model (default). `rules` runs with
# no model at all — typed text only, keyword intake, fixed sentences — for hosts
# that cannot hold the 7.2 GB download. Any other value stops the server.
SAFEPLATE_MODE=gemma

# Browser origins allowed to call the orchestrator, comma-separated. Empty means
# the defaults: http://localhost:3000 and https://safeplate-ten.vercel.app.
# A wildcard (*) is refused.
SAFEPLATE_CORS_ORIGINS=

# SerpApi — manufacturer allergen declarations.
# Get a key from https://serpapi.com/manage-api-key
#
# The free plan allows 250 searches a month and every response is cached to
# fixtures/serp/, so a repeated query costs nothing and the demo runs offline.
SERPAPI_KEY=

# Optional second key, used ONLY when the first is rejected (401/403) or out of
# quota (429). It is a failover, not a way to double the monthly budget — make
# sure whoever lends it agreed to that.
SERPAPI_KEY_FALLBACK=
